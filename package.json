{
  "name": "f1-island",
  "version": "0.1.0",
  "description": "A desktop Dynamic Island for Formula 1 on macOS and Windows: countdowns, standings, live flag alerts and session analysis. Unofficial fan project.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "AymanBAHHOU",
  "repository": {
    "type": "git",
    "url": "https://github.com/AymanBAHHOU/f1-island.git"
  },
  "keywords": [
    "formula1",
    "f1",
    "dynamic-island",
    "electron",
    "windows",
    "macos",
    "telemetry",
    "openf1"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "npm run native",
    "start": "electron .",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:mac": "electron scripts/smoke-macos.js",
    "pretest:mac": "npm run native",
    "native": "node scripts/build-native.js",
    "icons": "node scripts/create-icon.js",
    "prepack:mac": "npm run native && npm run icons",
    "pack:mac": "electron-builder --mac dmg zip --publish never",
    "prepack:mac:dir": "npm run native && npm run icons",
    "pack:mac:dir": "electron-builder --mac --dir --publish never",
    "prepack:win": "npm run icons",
    "pack:win": "electron-builder --win --publish never",
    "prepack:win:dir": "npm run icons",
    "pack:win:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  }
}
